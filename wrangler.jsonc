{
  "name": "tiennhatro-app",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RENTAL_DATA", "class_name": "RentalData" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RentalData"] }]
}
